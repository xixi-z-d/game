PORT=8765
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# MySQL production settings
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=draw_game
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=draw_game
MYSQL_SSL=true
# MYSQL_SSL_CA=/app/certs/database-ca.pem

# WeChat Mini Game login (server only; never put AppSecret in minigame files)
WECHAT_APPID=replace-with-your-mini-game-appid
WECHAT_APPSECRET=replace-with-your-mini-game-appsecret
WECHAT_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional moderation settings
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NICKNAME=管理员
PRIVACY_VERSION=1
# SENSITIVE_WORDS=词语1,词语2
# SENSITIVE_WORDS_FILE=/app/config/sensitive-words.txt

# Used only when MySQL variables are not configured.
DRAW_ACCOUNTS_FILE=/app/data/users.json
DRAW_REPORTS_FILE=/app/data/reports.json
